OPENAI_API_KEY=
OPENAI_BASE_URL=
# Origins allowed to call the API from a browser, comma-separated - only for a frontend
# deployed on another domain. Leave empty for local development.
CORS_ORIGINS=
# Directory of saved runs the frontend can open without API calls: listed as demos on
# the start page, and at http://localhost:5173/?sample=<name> (e.g.
# DEV_SAMPLES_DIR=../temp). Everything in it is served to anyone, so a deployed
# environment should point it at a directory holding only the demos.
DEV_SAMPLES_DIR=
